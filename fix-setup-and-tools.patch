+def _table(name: str) -> str:
+    """Resolve a free-form table hint to a known table name (default: openstack)."""
+    n = (name or "").lower()
+    if "bgl" in n:
+        return "bgl"
+    if "openstack" in n or "nova" in n or "os" == n:
+        return "openstack"
+    return "openstack"
+
+
+def _run(sql: str, params: tuple = ()) -> list[dict[str, Any]]:
+    with psycopg.connect(autocommit=True, **CONN) as conn, conn.cursor() as cur:
+        cur.execute(sql, params)
+        if not cur.description:
+            return []
+        cols = [d.name for d in cur.description]
+        return [dict(zip(cols, row)) for row in cur.fetchall()]
+
 
+def _fmt(rows: list[dict], applied: dict, limit: int | None = None) -> dict:
+    """Wrap results with the applied filters and a truncation flag the agent can read."""
+    out: dict[str, Any] = {"filters_applied": applied, "row_count": len(rows), "rows": rows}
+    if limit is not None:
+        out["truncated"] = len(rows) >= limit
+        out["limit"] = limit
+    return out
